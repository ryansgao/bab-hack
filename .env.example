# Anthropic task decomposition (server only). Leave the key blank until configured.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
# Removable hackathon recipe: false restores ordinary Anthropic planning for matcha.
MATCHA_DEMO_ENABLED=true
# Each plan is a paid Anthropic call. Limits are counted per server; lower them on a public host.
PLANNER_MAX_CALLS_PER_DAY=500
PLANNER_MAX_CALLS_PER_VISITOR_HOUR=60
# Local development. Keep .env private; never paste keys into the frontend.
SERVICE_KEY=
ROBOMARKET_DB=data/robomarket.sqlite
PAYMENT_DB=data/payments.sqlite
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
AUSD_ADDRESS=0xa9012a055bd4e0eDfF8Ce09f960291C09D5322dC
# Fund robot with test AUSD and facilitator with Base Sepolia ETH.
ROBOT_PRIVATE_KEY=
FACILITATOR_PRIVATE_KEY=
PROVIDER_ADDRESS=
# Optional. One payout address per vendor, derived from this seed; without it every vendor is paid at PROVIDER_ADDRESS.
VENDOR_SEED=
# Optional. Owner wallet that holds the AUSD treasury. When set, the robot holds only one mission
# float at a time (MAX_PER_TASK_AUSD), funded on the mission's first purchase and returned when the
# mission is closed or has been idle for FLOAT_IDLE_SECONDS. Fund this wallet, not the robot.
FLOAT_IDLE_SECONDS=90
OWNER_PRIVATE_KEY=

# Optional overrides; startup verifies the domain against DOMAIN_SEPARATOR.
AUSD_DOMAIN_NAME=
AUSD_DOMAIN_VERSION=1
MAX_PER_CALL_AUSD=0.05
MAX_PER_TASK_AUSD=0.10
MAX_SESSION_AUSD=5
MAX_DAILY_AUSD=5
APPROVAL_THRESHOLD_AUSD=0.05
ALLOWED_VENDORS=vision_lab,navigation_lab,gripworks,motion_lab,edge_vision,sentinel_safety,atlas_perception,budget_bots,feathertouch,lumen_labs,pantry_vision,quantum_grip,routewise
API_URL=http://127.0.0.1:8000
MODEL_URL=http://127.0.0.1:8001
PAYMENT_URL=http://127.0.0.1:4021
PAYMENT_HOST=127.0.0.1
PAYMENT_PORT=4021
# Optional. Owner-set spending policy and payment receipts on BNB chain (BSC Testnet, chain 97).
# Deploy with services/payments/scripts/deploy-policy.ts, then paste the printed address here.
# The operator key defaults to FACILITATOR_PRIVATE_KEY and needs testnet BNB for each receipt.
BNB_RPC_URL=https://bsc-testnet-rpc.publicnode.com
BNB_POLICY_CONTRACT=
